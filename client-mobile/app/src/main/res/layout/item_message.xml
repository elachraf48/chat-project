<?xml version="1.0" encoding="utf-8"?>
<!-- Chat message item — three view states (GONE/VISIBLE toggled in adapter):
     layoutSelf  → own message  (right-aligned, green bubble)
     layoutOther → other user   (left-aligned, white bubble)
     tvSystem    → system event (centered pill) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- ── Own message (right) ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_self"
            android:maxWidth="280dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvTextSelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/message_text_self"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"/>

            <TextView
                android:id="@+id/tvTimeSelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/timestamp_color"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Other user message (left) ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutOther"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sender_name_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_other"
            android:maxWidth="280dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvTextOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/message_text_other"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"/>

            <TextView
                android:id="@+id/tvTimeOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/timestamp_color"
                android:textSize="11sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ── System / event pill (centered) ────────────────────────────────── -->
    <TextView
        android:id="@+id/tvSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/system_msg_text"
        android:textSize="12sp"
        android:background="@drawable/bg_system_msg"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"/>

</LinearLayout>
