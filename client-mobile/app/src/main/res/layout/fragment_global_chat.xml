<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_chat">

    <!-- Message list — takes all remaining space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- ── Input bar — WhatsApp style ──────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/input_background"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- Attach (file) — left of input -->
        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/colorPrimary"
            android:contentDescription="@string/btn_attach"/>

        <!-- Emoji picker — left of input -->
        <Button
            android:id="@+id/btnEmoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="😊"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_emoji"
            android:padding="0dp"
            android:includeFontPadding="false"/>

        <!-- Text input with rounded background -->
        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_message"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="15sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"/>

        <!-- Record audio — right of input -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/colorPrimary"
            android:contentDescription="@string/btn_record"
            android:layout_marginEnd="2dp"/>

        <!-- Gemini AI — right of input -->
        <ImageButton
            android:id="@+id/btnAi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_help"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/colorPrimary"
            android:contentDescription="@string/btn_ai"
            android:layout_marginEnd="4dp"/>

        <!-- Send — green circle with arrow icon, like WhatsApp -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/bg_send_btn"
            android:tint="@color/white"
            android:contentDescription="@string/btn_send"
            android:padding="11dp"/>

    </LinearLayout>

</LinearLayout>
