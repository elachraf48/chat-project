<?xml version="1.0" encoding="utf-8"?>
<!-- File transfer bubble.
     layoutFileSelf  → own sent file (right-aligned, green bubble)
     layoutFileOther → received file (left-aligned, white bubble + Download button) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- ── Sent file (self, right) ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutFileSelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_self"
            android:maxWidth="260dp"
            android:elevation="1dp">

            <!-- File icon + name row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="📄"
                    android:textSize="20sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvFileNameSelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/message_text_self"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    android:paddingStart="6dp"/>

            </LinearLayout>

            <!-- Size + time row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvFileSizeSelf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/timestamp_color"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvFileTimeSelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/timestamp_color"
                    android:textSize="11sp"
                    android:paddingStart="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Sender name (received only) ────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvFileSenderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sender_name_color"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"/>

    <!-- ── Received file (other, left) ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutFileOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bubble_other"
        android:maxWidth="260dp"
        android:elevation="1dp"
        android:visibility="gone">

        <!-- File icon + name row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="📄"
                android:textSize="20sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvFileNameOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/message_text_other"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="middle"
                android:paddingStart="6dp"/>

        </LinearLayout>

        <!-- Size row -->
        <TextView
            android:id="@+id/tvFileSizeOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/timestamp_color"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <!-- Download button -->
        <Button
            android:id="@+id/btnDownloadFile"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="@string/btn_download"
            android:textColor="@color/download_btn_text"
            android:backgroundTint="@color/download_btn_bg"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

        <!-- Time -->
        <TextView
            android:id="@+id/tvFileTimeOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/timestamp_color"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

</LinearLayout>
